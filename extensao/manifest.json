{
  "manifest_version": 3,
  "name": "PokeLupa — Poke Idle World",
  "short_name": "PokeLupa",
  "version": "1.8.1",
  "description": "Passe o mouse para ver IV, qualidade e nota dos Pokémons, saiba quanto vale sua mochila e acompanhe o loot por hora no Poke Idle World.",
  "homepage_url": "https://skymerlight.github.io/pokelupa/",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "PokeLupa",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png"
    }
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.idleworld.online/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.idleworld.online/*"
      ],
      "js": [
        "conteudo/escuta.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.idleworld.online/*"
      ],
      "js": [
        "nucleo/idiomas.js",
        "nucleo/formulas.js",
        "nucleo/cartao.js",
        "conteudo/estilos.js",
        "conteudo/painel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}